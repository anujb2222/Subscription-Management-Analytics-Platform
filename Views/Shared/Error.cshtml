
@{
    ViewBag.Title = "Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg text-center py-5">
                <div class="card-body">
                    <i class="fas fa-exclamation-triangle fa-4x text-warning mb-4"></i>
                    <h1 class="text-danger mb-3">Oops! Something went wrong.</h1>
                    <p class="text-muted mb-4">We encountered an unexpected error while processing your request.</p>
                    <div class="mb-4">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg">
                            <i class="fas fa-home mr-2"></i> Return to Dashboard
                        </a>
                    </div>
                    <p class="text-sm text-muted mb-0">
                        If the problem persists, please contact support.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
