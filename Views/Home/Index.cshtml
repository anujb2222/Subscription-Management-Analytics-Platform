
@model Sublytic.Models.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
    ViewBag.ActiveNav = "Dashboard";
}

<div class="dashboard-header mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between">
        <div>
            <h1 class="page-title mb-1"><i class="fas fa-tachometer-alt text-primary mr-2"></i>Dashboard</h1>
            <p class="text-muted mb-0">Overview of your subscriptions and spending patterns</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a href="@Url.Action("Create", "Subscription")" class="btn btn-primary btn-lg">
                <i class="fas fa-plus mr-2"></i>Add Subscription
            </a>
        </div>
    </div>
</div>

<div class="row stats-cards-row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card stat-card-primary">
            <div class="stat-icon">
                <i class="fas fa-calendar-month"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Monthly Spend</div>
                <div class="stat-value">@Model.TotalMonthlySpend.ToString("C")</div>
                <div class="stat-change">
                    <i class="fas fa-arrow-trend-up"></i> @Model.ActiveSubscriptionsCount active subscriptions
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card stat-card-success">
            <div class="stat-icon">
                <i class="fas fa-calendar-year"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Annual Spend</div>
                <div class="stat-value">@Model.TotalAnnualSpend.ToString("C")</div>
                <div class="stat-change">
                    <i class="fas fa-calculator"></i> Projected yearly total
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card stat-card-warning">
            <div class="stat-icon">
                <i class="fas fa-bell"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Upcoming Renewals</div>
                <div class="stat-value">@Model.UpcomingRenewalCount</div>
                <div class="stat-change">
                    <i class="fas fa-calendar"></i> Next 30 days
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card stat-card-info">
            <div class="stat-icon">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Avg. Subscription</div>
                <div class="stat-value">@Model.AverageSubscriptionPrice.ToString("C")</div>
                <div class="stat-change">
                    <i class="fas fa-coins"></i> Per month
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm chart-card h-100">
            <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0"><i class="fas fa-chart-line text-primary mr-2"></i>Monthly Spending Trend</h5>
                <span class="badge badge-pill badge-light">Last 6 Months</span>
            </div>
            <div class="card-body">
                <div class="chart-container" style="position: relative; height: 320px;">
                    <canvas id="monthlyTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm chart-card h-100">
            <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0"><i class="fas fa-chart-pie text-warning mr-2"></i>Spending by Category</h5>
                <span class="badge badge-pill badge-light">Monthly</span>
            </div>
            <div class="card-body">
                <div class="chart-container" style="position: relative; height: 320px;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white border-bottom-0">
                <h5 class="card-title mb-0"><i class="fas fa-redo-alt text-success mr-2"></i>Upcoming Renewals</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.UpcomingRenewals != null && Model.UpcomingRenewals.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var sub in Model.UpcomingRenewals)
                        {
                            var daysUntil = (sub.NextRenewalDate.Date - DateTime.Today).TotalDays;
                            var urgencyClass = daysUntil <= 7 ? "urgent" : daysUntil <= 14 ? "warning" : "normal";
                            <li class="list-group-item renewal-item renewal-@urgencyClass">
                                <div class="d-flex w-100 justify-content-between align-items-center">
                                    <div class="flex-grow-1 min-w-0">
                                        <h6 class="mb-1 text-truncate">@sub.Name</h6>
                                        <small class="text-muted">
                                            <i class="fas fa-calendar-day mr-1"></i>
                                            @sub.NextRenewalDate.ToString("MMM dd, yyyy")
                                        </small>
                                    </div>
                                    <div class="text-right ml-3">
                                        <div class="font-weight-bold text-primary">@sub.Price.ToString("C")</div>
                                        <small>
                                            @if (daysUntil == 0)
                                            {
                                                <span class="badge badge-danger">Today!</span>
                                            }
                                            else if (daysUntil == 1)
                                            {
                                                <span class="badge badge-danger">Tomorrow</span>
                                            }
                                            else if (daysUntil < 0)
                                            {
                                                <span class="badge badge-secondary">Overdue</span>
                                            }
                                            else
                                            {
                                                <span class="badge @(daysUntil <= 7 ? "badge-danger" : daysUntil <= 14 ? "badge-warning" : "badge-info")">
                                                    @daysUntil days
                                                </span>
                                            }
                                        </small>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                        <p>No upcoming renewals</p>
                    </div>
                }
                <div class="card-footer bg-white border-top-0">
                    <a href="@Url.Action("Index", "Subscription")" class="btn btn-outline-primary btn-block btn-sm">
                        View All Subscriptions <i class="fas fa-arrow-right ml-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm chart-card h-100">
            <div class="card-header bg-white border-bottom-0">
                <h5 class="card-title mb-0"><i class="fas fa-sync-alt text-info mr-2"></i>Billing Cycles</h5>
            </div>
            <div class="card-body">
                <div class="chart-container" style="position: relative; height: 250px;">
                    <canvas id="billingCycleChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white border-bottom-0">
                <h5 class="card-title mb-0"><i class="fas fa-clock text-secondary mr-2"></i>Recent Activity</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentSubscriptions != null && Model.RecentSubscriptions.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var sub in Model.RecentSubscriptions)
                        {
                            var timeAgo = GetTimeAgo(sub.CreatedAt);
                            <li class="list-group-item activity-item">
                                <div class="d-flex align-items-center">
                                    <div class="activity-icon @(sub.IsActive ? "bg-success" : "bg-secondary") mr-3">
                                        <i class="fas @(sub.IsActive ? "fa-plus" : "fa-times") text-white"></i>
                                    </div>
                                    <div class="flex-grow-1 min-w-0">
                                        <h6 class="mb-1 text-truncate">@sub.Name</h6>
                                        <small class="text-muted">
                                            @(sub.IsActive ? "Added" : "Inactive") &middot; @timeAgo
                                        </small>
                                    </div>
                                    <div class="font-weight-bold ml-2">@sub.Price.ToString("C")</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-inbox fa-3x mb-3"></i>
                        <p>No recent activity</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 mb-4">
        <div class="card shadow-sm highlight-card bg-gradient">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h4 class="text-white mb-2">
                            <i class="fas fa-gem mr-2"></i> Financial Insight
                        </h4>
                        @if (!string.IsNullOrEmpty(Model.MostExpensiveSubscriptionName))
                        {
                            <p class="text-white-50 mb-0">
                                Your most expensive subscription is <strong class="text-white">@Model.MostExpensiveSubscriptionName</strong> at
                                <strong class="text-white">@Model.MostExpensiveSubscriptionPrice.ToString("C")/month</strong>.
                                Consider reviewing if you're getting enough value from it.
                            </p>
                        }
                        else
                        {
                            <p class="text-white-50 mb-0">Add your subscriptions to get personalized financial insights!</p>
                        }
                    </div>
                    <div class="col-md-4 text-center mt-3 mt-md-0">
                        <a href="@Url.Action("Index", "Analytics")" class="btn btn-light btn-lg">
                            <i class="fas fa-chart-line mr-2 text-primary"></i> View Full Analytics
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;
        if (timeSpan.TotalDays >= 365)
            return Math.Floor(timeSpan.TotalDays / 365) + " year(s) ago";
        if (timeSpan.TotalDays >= 30)
            return Math.Floor(timeSpan.TotalDays / 30) + " month(s) ago";
        if (timeSpan.TotalDays >= 1)
            return Math.Floor(timeSpan.TotalDays) + " day(s) ago";
        if (timeSpan.TotalHours >= 1)
            return Math.Floor(timeSpan.TotalHours) + " hour(s) ago";
        if (timeSpan.TotalMinutes >= 1)
            return Math.Floor(timeSpan.TotalMinutes) + " minute(s) ago";
        return "Just now";
    }
}

@section scripts {
<script>
$(document).ready(function () {
    initDashboardCharts(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlySpendingTrend)),
                       @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SpendingByCategory)),
                       @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SubscriptionsByBillingCycle)));
});
</script>
}
